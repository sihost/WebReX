@PACKAGE_INIT@

# SDK share directory (entry point sources, etc.)
set(REXGLUE_SHARE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/rexglue")

include(CMakeFindDependencyMacro)

# Helper functions for consumer projects
include("${CMAKE_CURRENT_LIST_DIR}/rexglue_helpers.cmake")

# Ensure bundled dependencies are found from the SDK install prefix
list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")

# Required dependencies
find_dependency(fmt CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(Snappy CONFIG)
find_dependency(utf8cpp CONFIG)
if(NOT EMSCRIPTEN)
    # SDL3 is not built for the web (audio/input SDL drivers are excluded).
    find_dependency(SDL3 CONFIG)
endif()

# Vulkan dependencies
set(REXGLUE_USE_VULKAN @REXGLUE_USE_VULKAN@)
if(REXGLUE_USE_VULKAN)
    find_dependency(VulkanHeaders CONFIG)
    find_dependency(volk CONFIG)
    find_dependency(VulkanMemoryAllocator CONFIG)
endif()

# Include the generated targets
include("${CMAKE_CURRENT_LIST_DIR}/rexglueTargets.cmake")

# The recompiler CLI is a host tool and is not built for Emscripten. Projects'
# generated rexglue.cmake still reference rex::rexglue for their codegen
# target, so point it at the native CLI (sibling native install by default).
if(EMSCRIPTEN AND NOT TARGET rex::rexglue)
    if(CMAKE_HOST_WIN32)
        set(_rexglue_host_cli "${PACKAGE_PREFIX_DIR}/../win-amd64/bin/rexglue.exe")
    else()
        set(_rexglue_host_cli "${PACKAGE_PREFIX_DIR}/../linux-amd64/bin/rexglue")
    endif()
    set(REXGLUE_HOST_REXGLUE "${_rexglue_host_cli}"
        CACHE FILEPATH "Native rexglue CLI used by codegen targets in web builds")
    add_executable(rex::rexglue IMPORTED)
    set_target_properties(rex::rexglue PROPERTIES IMPORTED_LOCATION "${REXGLUE_HOST_REXGLUE}")
endif()

check_required_components(rexglue)
