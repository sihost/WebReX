{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_DEFAULT_CONFIGS": "all",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_CROSS_CONFIGS": "all",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
                "CMAKE_DEFAULT_CONFIGS": "all",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "win-amd64",
            "displayName": "Windows AMD64",
            "description": "Multi-config build for Windows AMD64 using Clang",
            "inherits": "windows-base"
        },
        {
            "name": "linux-amd64",
            "displayName": "Linux AMD64",
            "description": "Multi-config build for Linux AMD64 using Clang 20",
            "inherits": "linux-base"
        },
        {
            "name": "wasm64-base",
            "hidden": true,
            "description": "Emscripten wasm64 (run emsdk_env first so $env{EMSDK} is set). Short binary dirs: Windows 250-char object paths.",
            "generator": "Ninja",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-m64 -pthread -msimd128 -fwasm-exceptions -sSUPPORT_LONGJMP=wasm",
                "CMAKE_CXX_FLAGS": "-m64 -pthread -msimd128 -fwasm-exceptions -sSUPPORT_LONGJMP=wasm",
                "CMAKE_EXE_LINKER_FLAGS": "-m64 -pthread -fwasm-exceptions -sSUPPORT_LONGJMP=wasm",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/wasm64"
            }
        },
        {
            "name": "wasm64-release",
            "displayName": "wasm64 Release (Emscripten)",
            "inherits": "wasm64-base",
            "binaryDir": "C:/rex/b/w64r",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "wasm64-debug",
            "displayName": "wasm64 Debug (Emscripten)",
            "inherits": "wasm64-base",
            "binaryDir": "C:/rex/b/w64d",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        }
    ],
    "buildPresets": [
        {
            "name": "win-amd64-debug",
            "configurePreset": "win-amd64",
            "configuration": "Debug"
        },
        {
            "name": "win-amd64-release",
            "configurePreset": "win-amd64",
            "configuration": "Release"
        },
        {
            "name": "win-amd64-relwithdebinfo",
            "configurePreset": "win-amd64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-amd64-debug",
            "configurePreset": "linux-amd64",
            "configuration": "Debug"
        },
        {
            "name": "linux-amd64-release",
            "configurePreset": "linux-amd64",
            "configuration": "Release"
        },
        {
            "name": "linux-amd64-relwithdebinfo",
            "configurePreset": "linux-amd64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "wasm64-release",
            "configurePreset": "wasm64-release"
        },
        {
            "name": "wasm64-debug",
            "configurePreset": "wasm64-debug"
        }
    ],
    "testPresets": [
        {
            "name": "win-amd64-debug",
            "configurePreset": "win-amd64",
            "configuration": "Debug"
        },
        {
            "name": "win-amd64-release",
            "configurePreset": "win-amd64",
            "configuration": "Release"
        },
        {
            "name": "win-amd64-relwithdebinfo",
            "configurePreset": "win-amd64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-amd64-debug",
            "configurePreset": "linux-amd64",
            "configuration": "Debug"
        },
        {
            "name": "linux-amd64-release",
            "configurePreset": "linux-amd64",
            "configuration": "Release"
        },
        {
            "name": "linux-amd64-relwithdebinfo",
            "configurePreset": "linux-amd64",
            "configuration": "RelWithDebInfo"
        }
    ]
}
